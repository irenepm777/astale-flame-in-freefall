{
  "name": "astale",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Astale: fire-safety dashboard for spacecraft, built on NASA microgravity combustion data (NASA Space Apps Challenge 2026, Flame in Freefall).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && npx -y netlify-cli@27.18.0 dev --port 8520 --offline",
    "test": "node tests/run-all.mjs",
    "deploy": "node scripts/deploy.mjs",
    "data:psi": "node scripts/fetch-psi.mjs",
    "data:export": "node scripts/export-model-data.mjs",
    "bridge": "node scripts/si-bridge.mjs"
  },
  "devDependencies": {
    "@netlify/functions": "^4.3.0",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "@netlify/blobs": "^8.2.0"
  }
}
